# Browser-visible settings only. Never put API keys or secrets in VITE_* values.
VITE_API_BASE_URL=/api
# Development proxy; production hosting must route /api to authoring-service.
VITE_PROXY_TARGET=http://localhost:8001
# Local reviewer identity headers, not an authentication mechanism.
VITE_DEFAULT_REVIEWER_ID=hse_reviewer@smartloto.io
VITE_DEFAULT_REVIEWER_ROLE=hse_reviewer
