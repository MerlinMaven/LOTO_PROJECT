{
  "name": "smartloto-hse-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SmartLOTO HSE Review Dashboard — human-in-the-loop validation of AI-generated LOTO procedures.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
