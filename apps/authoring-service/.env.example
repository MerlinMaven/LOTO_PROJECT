# ── Database ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL direct connection (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Synchronous URL used by Alembic (only for migrations — not runtime)
SYNC_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key
STORAGE_BUCKET=smartloto-assets

# ── LLM Providers (set at least one, or use provider=stub for testing) ────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192
# vLLM self-hosted (leave blank if not using)
VLLM_BASE_URL=
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HF_TOKEN=
