# ── Database ──────────────────────────────────────────────────────────────────
# Configuration locale commune : voir aussi le .env.example à la racine.
# Chemin relatif à la racine du workspace, partagé avec field-service.
DATABASE_URL=sqlite+aiosqlite:///data/smartloto.db

# Alternative propre à authoring-service ; field-service utilise SQLite.
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Synchronous URL used by Alembic (only for migrations — not runtime)
# SYNC_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key
STORAGE_BUCKET=smartloto-assets

# ── LLM Providers (set at least one, or use provider=stub for testing) ────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# PDF generation uses Groq Qwen vision by default when GROQ_API_KEY is set.
# Set DOCUMENT_GENERATION_PROVIDER=gemini to use native PDF input instead.
DOCUMENT_GENERATION_PROVIDER=groq
GROQ_DOCUMENT_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PROVIDER_REQUEST_TIMEOUT_SECONDS=150
MAX_GENERATION_JOB_SECONDS=480
# vLLM self-hosted (leave blank if not using)
VLLM_BASE_URL=
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HF_TOKEN=
