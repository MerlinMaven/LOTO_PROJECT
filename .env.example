# Shared local configuration for both APIs. Copy to .env at the repository root.
# Keep real credentials in .env only; never place them in VITE_* variables.
DATABASE_URL=sqlite+aiosqlite:///data/smartloto.db
APP_ENV=development
ALLOW_SELF_APPROVAL=false

# PDF extraction, semantic citation checks and contextual field vision use Gemini.
# Required for AI calls: supply your private key and an enabled model ID.
DOCUMENT_GENERATION_PROVIDER=gemini
FIELD_VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
PROVIDER_REQUEST_TIMEOUT_SECONDS=150
MAX_GENERATION_JOB_SECONDS=480
FIELD_VISION_TIMEOUT=90
FIELD_VISION_MIN_CONFIDENCE=0.8

# Field artifact URLs; use the server LAN address when connecting a headset.
BASE_URL=http://127.0.0.1:8000
# Optional absolute overrides; omit to use the service defaults.
# LOCAL_STORAGE_DIR=/absolute/path/to/field-storage
# YOLO_MODEL_PATH=/absolute/path/to/yolov8s-worldv2.pt
YOLO_CONFIDENCE=0.15

# Optional providers used by the legacy text-generation path.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_DOCUMENT_MODEL=qwen/qwen3.8-27b
VLLM_BASE_URL=
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
