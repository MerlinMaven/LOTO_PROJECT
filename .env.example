# Configuration locale commune aux deux API. Copier vers .env à la racine.
# Les chemins SQLite relatifs sont résolus depuis la racine du workspace.
# DATABASE_URL a priorité sur SQLITE_DB_PATH ; ne pas définir deux bases différentes.
DATABASE_URL=sqlite+aiosqlite:///data/smartloto.db
# SQLITE_DB_PATH=data/smartloto.db
APP_ENV=development

# Génération PDF : choisir groq ou gemini, puis renseigner la clé correspondante.
# Les services démarrent sans clé ; une génération réelle nécessite un fournisseur.
DOCUMENT_GENERATION_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_DOCUMENT_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PROVIDER_REQUEST_TIMEOUT_SECONDS=150
MAX_GENERATION_JOB_SECONDS=480

# Autres fournisseurs (facultatifs).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
VLLM_BASE_URL=
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Field-service : URL publique des preuves / signatures / rapports.
BASE_URL=http://127.0.0.1:8000
YOLO_CONFIDENCE=0.15
# Laisser absents pour utiliser les chemins absolus par défaut du service :
# apps/field-service/weights/yolov8s-worldv2.pt et apps/field-service/storage/.
# YOLO_MODEL_PATH relatif est résolu depuis apps/field-service/.
# Pour LOCAL_STORAGE_DIR, utiliser un chemin absolu.
# YOLO_MODEL_PATH=C:/models/yolov8s-worldv2.pt
# LOCAL_STORAGE_DIR=C:/smartloto/storage

# Frontend : voir apps/hse-dashboard/.env.example (variables VITE_* uniquement).
