# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.Python

# Alembic compiled
*.pyc

# ── Machine learning models ───────────────────────────────────────────────────
# Large binary models must never be committed to git.
# Store them on a model registry (HuggingFace Hub, S3, etc.) and
# download at deploy time.
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors
*.bin

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.npm
dist/
.next/
out/
coverage/
*.tsbuildinfo
frontend/.env
frontend/.env.local
frontend/.env.production

# ── OS & tooling ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Tunnel tools (ngrok, localtunnel etc.) ────────────────────────────────────
# Never commit tunnel executables or archives to version control.
ngrok*
*.zip
*.tar.gz
*.exe
*.msi

# ── Runtime-generated files ───────────────────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/data/*
!/data/.gitkeep
apps/authoring-service/data/documents/*
!apps/authoring-service/data/documents/.gitkeep
apps/field-service/storage/evidence/*
!apps/field-service/storage/evidence/.gitkeep
apps/field-service/storage/reports/*
!apps/field-service/storage/reports/.gitkeep
apps/field-service/storage/signatures/*
