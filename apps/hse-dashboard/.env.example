# Base URL for the SmartLOTO FastAPI backend.
# Leave as /api to use the Vite dev proxy (recommended in development).
VITE_API_BASE_URL=/api

# Target the dev proxy forwards /api to (used only by vite.config.ts in dev).
VITE_PROXY_TARGET=http://localhost:8001

# Reviewer identity sent as X-User-Id / X-User-Role until real auth (JWT) lands.
# The backend's get_current_user stub reads these headers.
VITE_DEFAULT_REVIEWER_ID=hse_reviewer@smartloto.io
VITE_DEFAULT_REVIEWER_ROLE=hse_reviewer
