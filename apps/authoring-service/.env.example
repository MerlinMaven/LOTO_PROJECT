# Optional service-specific configuration. Prefer the shared root .env.
# A service-local .env can shadow the root file; both APIs must use the same DB.
DATABASE_URL=sqlite+aiosqlite:///data/smartloto.db
APP_ENV=development
ALLOW_SELF_APPROVAL=false
DOCUMENT_GENERATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
PROVIDER_REQUEST_TIMEOUT_SECONDS=150
MAX_GENERATION_JOB_SECONDS=480

# Optional legacy text-generation providers.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_DOCUMENT_MODEL=qwen/qwen3.8-27b
VLLM_BASE_URL=
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
